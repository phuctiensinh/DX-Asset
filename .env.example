# App Settings
APP_NAME=DX-Asset
APP_ENV=development
SECRET_KEY=change-this-in-production-super-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
POSTGRES_USER=dx_user
POSTGRES_PASSWORD=dx_password_secret
POSTGRES_DB=dx_asset_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dx_user:dx_password_secret@postgres:5432/dx_asset_db

# Frontend Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# AI Service Configuration (Optional)
AI_ENABLED=true
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
